COPILOT_PROVIDER=claude
ANTHROPIC_API_KEY=replace_with_your_private_key
CLAUDE_MODEL_PUBLIC=claude-haiku-4-5
CLAUDE_MODEL_RESEARCHER=claude-sonnet-5
CLAUDE_TIMEOUT_SECONDS=60
CLAUDE_MAX_TOKENS=8192

# Local dev default is fine as-is -- only matters when deploying (see
# DEPLOYMENT.md). Comma-separated if the frontend has more than one real URL.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Per-IP limit on Copilot specifically, since that's where a request costs
# real API money. Local dev default is generous; consider tightening for a
# public deployment depending on expected traffic.
COPILOT_RATE_LIMIT_MAX=12
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60

# The warehouse-writing admin endpoint is open only in local development when
# this is unset. Set it in any production deployment and send it as the
# X-Pipeline-Admin-Token header from a private operator/scheduler.
# PIPELINE_ADMIN_TOKEN=replace_with_a_long_random_token
APP_ENV=development

# Heavy analytical defaults. Increase only when the host has enough memory.
AIRLINE_DEFAULT_HEAVY_LOOKBACK_DAYS=365
AIRLINE_DEFAULT_MODEL_LOOKBACK_DAYS=1825
AIRLINE_SOLVER_TIME_LIMIT_SECONDS=30

# Only needed if the warehouse file lives somewhere other than the default
# Data/Warehouse/airline.duckdb -- e.g. a persistent disk mount in
# production. Leave unset for local dev.
# AIRLINE_DUCKDB_PATH=/data/airline.duckdb
